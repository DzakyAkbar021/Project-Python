# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN upload file .env ke GitHub (sudah dimasukkan ke .gitignore).

# Kunci rahasia untuk mengamankan sesi login. WAJIB diganti.
# Buat dengan perintah:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang

# Nama sekolah yang tampil di footer dan beranda.
NAMA_SEKOLAH=SMK Plus Pelita Nusantara

# 1 = mode pengembangan (halaman otomatis dimuat ulang saat kode diubah).
# Isi 0 jika sudah dipakai di server sungguhan.
FLASK_DEBUG=1

# Port server lokal (ubah jika 5000 sudah dipakai program lain).
PORT=5000

# Aktifkan (hapus tanda #) HANYA jika website sudah memakai HTTPS.
# SESSION_COOKIE_SECURE=1
